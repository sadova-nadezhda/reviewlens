# Скопируйте в .env и заполните. Файл .env не коммитится.
# Ключи: Supabase Dashboard → Project Settings → API Keys

# Публичные значения: попадают в клиентский бандл
VITE_SUPABASE_URL=https://mgnvvvoyvhdnxcdqjzob.supabase.co
VITE_SUPABASE_ANON_KEY=

# Публичный ключ сайта Cloudflare Turnstile (проверка на робота при входе).
# 1x00000000000000000000AA — тестовый ключ Cloudflare, всегда проходит проверку. Он работает, только если
# в Supabase Auth указан парный тестовый секрет; с боевым секретом нужен боевой ключ сайта.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA

# Секретный ключ: обходит RLS. Используется только seed-скриптом (npm run seed).
# Никогда не добавляйте префикс VITE_ — иначе ключ попадёт в клиентский бандл.
SUPABASE_SERVICE_ROLE_KEY=
